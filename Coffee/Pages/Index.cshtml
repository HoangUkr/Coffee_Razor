@page
@model WebUI.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hidden form for antiforgery token -->
<form id="antiforgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- HERO SLIDER -->
