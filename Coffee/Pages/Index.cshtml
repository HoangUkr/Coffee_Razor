<!-- BEST SELLERS SECTION (Dynamic from Database) -->
<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center mb-5 pb-3">
            <div class="col-md-7 heading-section ftco-animate text-center">
                <span class="subheading">Discover</span>
                <h2 class="mb-4">Best Coffee Sellers</h2>
                <p>Far far away, behind the word mountains, far from the countries Vokalia and Consonantia, there live the blind texts.</p>
            </div>
        </div>
        <div class="row">
            @foreach (var item in Model.BestSellers)
            {
                <div class="col-md-3">
                    <div class="menu-entry">
                        <a asp-page="/Items/Details" asp-route-id="@item.Id" class="img" style="background-image: url(@item.DefaultImageUrl);"></a>
                        <div class="text text-center pt-4">
                            <h3><a asp-page="/Items/Details" asp-route-id="@item.Id">@item.Name</a></h3>
                            <p>@item.CategoryName</p>
                            <p class="price"><span>@item.Price.ToString("C")</span></p>
                            <p>
                                <button type="button" class="btn btn-primary btn-outline-primary" onclick="addToCart(@item.Id)">
                                    Add to Cart
                                </button>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- WORKING HOURS SECTION -->
@if (Model.Schedule.Any())
{
    <section class="ftco-section ftco-counter img" style="background-image: url(@Url.Content("~/images/bg_3.jpg"));">
        <div class="overlay"></div>
        <div class="container">
            <div class="row justify-content-center mb-5 pb-3">
                <div class="col-md-7 heading-section heading-section-white ftco-animate text-center">
                    <span class="subheading">Hours</span>
                    <h2 class="mb-2">Opening Hours</h2>
                </div>
            </div>

            @if (Model.TodayClosedReason is not null)
            {
                <div class="row justify-content-center mb-4">
                    <div class="col-md-8 col-lg-6">
                        <div class="text-center py-2 px-4 rounded" style="background:rgba(220,53,69,.25); border:1px solid rgba(220,53,69,.5);">
                            <i class="icon-calendar text-white me-2"></i>
                            <span class="text-white fw-semibold">@Model.TodayClosedReason</span>
                        </div>
                    </div>
                </div>
            }

            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="ftco-animate">
                        @foreach (var entry in Model.Schedule)
                        {
                            var isToday = entry.Day == DateTime.Today.DayOfWeek;
                            var isLast  = entry == Model.Schedule.Last();
                            <div class="d-flex justify-content-between align-items-center py-2 @(!isLast ? "border-bottom border-white-10" : "")">
                                <span class="text-white @(isToday ? "fw-bold" : "") opacity-90">
                                    @if (isToday)
                                    {
                                        <span class="badge bg-primary me-2">Today</span>
                                    }
                                    @entry.DayName
                                </span>
                                @if (isToday && Model.TodayClosedReason is not null)
                                {
                                    <span class="text-white-50 fst-italic">Holiday</span>
                                }
                                else if (entry.IsClosed)
                                {
                                    <span class="text-white-50 fst-italic">Closed</span>
                                }
                                else
                                {
                                    <span class="text-white @(isToday ? "fw-bold" : "") opacity-90">
                                        @entry.OpenTime.ToString("h:mm tt") &ndash; @entry.CloseTime.ToString("h:mm tt")
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@section Scripts {
    <script>
        async function addToCart(itemId) {
            try {
                // Get the antiforgery token
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const formData = new FormData();
                formData.append('itemId', itemId);
                formData.append('quantity', 1);
                if (token) {
                    formData.append('__RequestVerificationToken', token);
                }

                const response = await fetch('/Cart?handler=AddToCart', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error('Failed to add item to cart');
                }

                const result = await response.json();

                if (result.success) {
                    // Update cart count in header
                    const cartCountElements = document.querySelectorAll('.cart-count, #cart-count');
                    cartCountElements.forEach(element => {
                        element.textContent = result.itemCount;
                    });

                    // Show success message
                    showToast('Item added to cart!', 'success');
                } else {
                    showToast(result.message || 'Failed to add item to cart', 'error');
                }
            } catch (error) {
                console.error('Error adding item to cart:', error);
                showToast('An error occurred. Please try again.', 'error');
            }
        }

        function showToast(message, type) {
            // Create toast element
            const toast = document.createElement('div');
            toast.className = `alert alert-${type === 'success' ? 'success' : 'danger'} position-fixed`;
            toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 250px;';
            toast.innerHTML = `
                <i class="icon-${type === 'success' ? 'check' : 'alert-circle'}"></i> ${message}
            `;
            document.body.appendChild(toast);

            // Auto remove after 3 seconds
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        // Debug booking form submission
        $(document).ready(function() {
            // Auto-dismiss alerts after 3 seconds
            setTimeout(function() {
                $('.alert').fadeOut('slow', function() {
                    $(this).remove();
                });
            }, 3000); // 3 seconds

            // Check if there's a success message and clear the form
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <text>
                // Clear the booking form after successful submission
                $('#bookingForm')[0].reset();

                // Clear and reset the datepicker
                if (typeof $.fn.datepicker !== 'undefined') {
                    $('.appointment_date').datepicker('clearDates');
                    $('.appointment_date').val('');
                }

                // Clear the timepicker
                $('.appointment_time').val('');
                </text>
            }

            $('#bookingForm').on('submit', function(e) {
                console.log('Booking form is being submitted...');
                console.log('Form data:', $(this).serialize());
            });

            // Ensure datepicker and timepicker are initialized
            if (typeof $.fn.datepicker !== 'undefined') {
                // Destroy existing datepicker instance if it exists
                $('.appointment_date').datepicker('destroy');

                // Reinitialize with fresh settings
                $('.appointment_date').datepicker({
                    'format': 'm/d/yyyy',
                    'autoclose': true,
                    'startDate': new Date(),  // Prevent selecting past dates
                    'clearBtn': true,
                    'todayHighlight': true
                });

                // Clear any existing value
                $('.appointment_date').datepicker('clearDates');
            }

            if (typeof $.fn.timepicker !== 'undefined') {
                $('.appointment_time').timepicker({
                    'timeFormat': 'g:i A',
                    'interval': 30,
                    'minTime': '8:00am',
                    'maxTime': '9:00pm',
                    'startTime': '8:00am',
                    'dynamic': false,
                    'dropdown': true,
                    'scrollbar': true
                });
            }
        });
    </script>
}
