@page
@model WebUI.Pages.Admin.Settings.OthersModel
@{
    ViewData["Title"] = "Other Settings";
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";
}

<main id="content" class="content py-10">
    <div class="container-fluid">

        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="fs-3 mb-1">Other Settings</h1>
                        <p class="mb-0 text-muted">Contact information and system behaviour</p>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="ti ti-check me-2"></i>@Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="ti ti-alert-circle me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form method="post">
            <div class="row g-4">

                <!-- Contact Information -->
                <div class="col-lg-6">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                <i class="ti ti-address-book me-2"></i>Contact Information
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">Email Address</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-mail"></i></span>
                                        <input type="email" class="form-control" asp-for="Input.ContactEmail"
                                               placeholder="contact@example.com" />
                                    </div>
                                    <span asp-validation-for="Input.ContactEmail" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Facebook URL</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-brand-facebook"></i></span>
                                        <input type="url" class="form-control" asp-for="Input.ContactFacebook"
                                               placeholder="https://facebook.com/yourpage" />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Instagram URL</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-brand-instagram"></i></span>
                                        <input type="url" class="form-control" asp-for="Input.ContactInstagram"
                                               placeholder="https://instagram.com/yourpage" />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Twitter / X URL</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-brand-x"></i></span>
                                        <input type="url" class="form-control" asp-for="Input.ContactTwitter"
                                               placeholder="https://x.com/yourpage" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- System Behaviour -->
                <div class="col-lg-6">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                <i class="ti ti-settings me-2"></i>System Behaviour
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <div>
                                            <div class="fw-semibold">Email Confirmations</div>
                                            <div class="text-muted small">Send confirmation emails for orders and reservations</div>
                                        </div>
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox" role="switch"
                                                   asp-for="Input.EmailConfirmationEnabled" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="d-flex justify-content-between align-items-center py-2">
                                        <div>
                                            <div class="fw-semibold">Notification Badge</div>
                                            <div class="text-muted small">Show unread notification count on the bell icon</div>
                                        </div>
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox" role="switch"
                                                   asp-for="Input.ShowNotificationCount" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Save -->
            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="ti ti-device-floppy me-2"></i>Save Settings
                    </button>
                </div>
            </div>
        </form>

    </div>
</main>
