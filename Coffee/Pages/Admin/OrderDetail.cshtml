@page
@model WebUI.Pages.Admin.OrderDetailModel
@using Domain.Enums
@{
    ViewData["Title"] = $"Order {Model.Order?.OrderCode ?? "Details"}";
}

<!-- MAIN CONTENT -->
<main id="content" class="content py-10">
    <div class="container-fluid">
        @if (Model.Order != null)
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a asp-page="/Admin/Orders">Orders</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">@Model.Order.OrderCode</li>
                                </ol>
                            </nav>
                            <h1 class="fs-3 mb-1">Order @Model.Order.OrderCode</h1>
                            <p class="mb-0 text-muted">
                                Order placed on @Model.Order.CreatedDate.ToString("MMMM dd, yyyy 'at' HH:mm")
                            </p>
                        </div>
                        <div>
                            <a asp-page="/Admin/Orders" class="btn btn-outline-secondary">
                                <i class="ti ti-arrow-left me-2"></i>Back to Orders
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="row">
                    <div class="col-12">
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="ti ti-check me-2"></i>@Model.SuccessMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="row">
                    <div class="col-12">
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="ti ti-alert-circle me-2"></i>@Model.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
            }

            <div class="row">
                <!-- Order Status Card -->
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Order Status</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label text-muted small">Current Status</label>
                                <div>
                                    <span class="badge @Model.GetStatusBadgeClass(Model.Order.Status) fs-6">
                                        @Model.GetStatusDisplayName(Model.Order.Status)
                                    </span>
                                </div>
                            </div>

                            @if (Model.Order.Status != OrderStatus.Completed)
                            {
                                <hr />
                                <div>
                                    <label class="form-label text-muted small">Update Status</label>
                                    <div class="d-grid gap-2">
                                        @{
                                            var nextStatus = Model.GetNextStatus(Model.Order.Status, Model.Order.FulfillmentScope, Model.Order.OutHouseFulfillmentType);
                                            if (!string.IsNullOrEmpty(nextStatus))
                                            {
                                                var status = Enum.Parse<OrderStatus>(nextStatus);
                                                <form method="post" asp-page-handler="UpdateStatus">
                                                    <input type="hidden" name="orderCode" value="@Model.Order.OrderCode" />
                                                    <input type="hidden" name="version" value="@Model.Order.Version" />
                                                    <input type="hidden" name="newStatus" value="@status" />
                                                    <button type="submit" 
                                                            class="btn btn-primary w-100"
                                                            onclick="return confirm('Update order status to @Model.GetStatusDisplayName(status)?')">
                                                        <i class="ti ti-arrow-right me-2"></i>Mark as @Model.GetStatusDisplayName(status)
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            <hr />
                            <div>
                                <label class="form-label text-muted small">Order Timeline</label>
                                <div class="small">
                                    <div class="mb-2">
                                        <i class="ti ti-calendar me-2"></i>
                                        <strong>Created:</strong> @Model.Order.CreatedDate.ToString("MMM dd, yyyy HH:mm")
                                    </div>
                                    @if (Model.Order.CompletedDate.HasValue)
                                    {
                                        <div>
                                            <i class="ti ti-check me-2"></i>
                                            <strong>Completed:</strong> @Model.Order.CompletedDate.Value.ToString("MMM dd, yyyy HH:mm")
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Customer Information Card -->
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Customer Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label text-muted small">Customer Code</label>
                                <div><strong>@Model.Order.CustomerCode</strong></div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small">Name</label>
                                <div>@Model.Order.CustomerFirstName @Model.Order.CustomerLastName</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small">Email</label>
                                <div>
                                    @if (!string.IsNullOrEmpty(Model.Order.CustomerEmail))
                                    {
                                        <a href="mailto:@Model.Order.CustomerEmail">@Model.Order.CustomerEmail</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small">Phone</label>
                                <div>
                                    @if (!string.IsNullOrEmpty(Model.Order.CustomerPhone))
                                    {
                                        <a href="tel:@Model.Order.CustomerPhone">@Model.Order.CustomerPhone</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delivery Information Card -->
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Delivery Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label text-muted small">Fulfillment Scope</label>
                                <div>
                                    <span class="badge @(Model.Order.FulfillmentScope == OrderFulfillmentScope.InHouse ? "bg-success" : "bg-info")">
                                        @Model.Order.FulfillmentScope
                                    </span>
                                </div>
                            </div>
                            @if (Model.Order.FulfillmentScope == OrderFulfillmentScope.OutHouse)
                            {
                                <div class="mb-3">
                                    <label class="form-label text-muted small">Out-House Fulfillment Type</label>
                                    <div>
                                        <span class="badge @(Model.Order.OutHouseFulfillmentType == OutHouseFulfillmentType.Pickup ? "bg-info" : "bg-warning")">
                                            @(Model.Order.OutHouseFulfillmentType?.ToString() ?? "Not selected")
                                        </span>
                                    </div>
                                </div>
                            }
                            @if (Model.Order.OutHouseFulfillmentType == OutHouseFulfillmentType.Delivery)
                            {
                                <div class="mb-3">
                                    <label class="form-label text-muted small">Delivery Address</label>
                                    <div>
                                        @if (!string.IsNullOrEmpty(Model.Order.DeliveryAddress))
                                        {
                                            @Model.Order.DeliveryAddress
                                        }
                                        else
                                        {
                                            <span class="text-muted">Address cleared (privacy)</span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Order.Notes))
                            {
                                <div>
                                    <label class="form-label text-muted small">Notes</label>
                                    <div class="small">@Model.Order.Notes</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Items Card -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Order Items</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Item</th>
                                            <th>Category</th>
                                            <th class="text-end">Unit Price</th>
                                            <th class="text-center">Quantity</th>
                                            <th class="text-end">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Order.Items)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        @if (!string.IsNullOrEmpty(item.ItemImage))
                                                        {
                                                            <img src="@item.ItemImage" 
                                                                 alt="@item.ItemName" 
                                                                 class="rounded me-3"
                                                                 style="width: 50px; height: 50px; object-fit: cover;">
                                                        }
                                                        <div>
                                                            <strong>@item.ItemName</strong>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>@item.CategoryName</td>
                                                <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                                <td class="text-center">
                                                    <span class="badge bg-secondary">@item.Quantity</span>
                                                </td>
                                                <td class="text-end">
                                                    <strong>@((item.UnitPrice * item.Quantity).ToString("C"))</strong>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="table-active">
                                            <td colspan="3"></td>
                                            <td class="text-center">
                                                <strong>@Model.Order.TotalItemsAmount items</strong>
                                            </td>
                                            <td class="text-end">
                                                <strong class="fs-5">@Model.Order.TotalPrice.ToString("C")</strong>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-warning">
                        <i class="ti ti-alert-triangle me-2"></i>Order not found.
                    </div>
                </div>
            </div>
        }
    </div>
</main>
