@page
@model WebUI.Pages.Admin.ReservationModel
@{
    ViewData["Title"] = "Reservations";
}

<!-- MAIN CONTENT -->
<main id="content" class="content py-10">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="">
                        <h1 class="fs-3 mb-1">Reservations</h1>
                        <p class="mb-0">
                            @if (Model.SelectedDate.HasValue)
                            {
                                <text>Manage table reservations for @Model.SelectedDate.Value.ToString("MMMM dd, yyyy")</text>
                            }
                            else
                            {
                                <text>Manage all table reservations</text>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                            {
                                <span class="badge bg-secondary ms-2">Search: "@Model.SearchTerm"</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
                            {
                                <span class="badge bg-secondary ms-2">Status: @Model.StatusFilter</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="ti ti-check me-2"></i>@Model.SuccessMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="ti ti-alert-circle me-2"></i>@Model.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        }

        <!-- Date Navigation -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <form method="get" id="filterForm">
                            <div class="row g-3 align-items-end">
                                <!-- Search -->
                                <div class="col-md-3">
                                    <label for="searchTerm" class="form-label">Search</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-search"></i></span>
                                        <input type="text" 
                                               id="searchTerm" 
                                               name="searchTerm"
                                               class="form-control" 
                                               placeholder="Name, phone, email..."
                                               value="@Model.SearchTerm" />
                                    </div>
                                </div>

                                <!-- Date Filter -->
                                <div class="col-md-3">
                                    <label for="selectedDate" class="form-label">Date Filter</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ti ti-calendar"></i></span>
                                        <input type="date" 
                                               id="selectedDate" 
                                               name="selectedDate"
                                               class="form-control" 
                                               value="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" />
                                        @if (Model.SelectedDate.HasValue)
                                        {
                                            <button type="button" 
                                                    onclick="clearDateFilter()" 
                                                    class="btn btn-outline-secondary"
                                                    title="Clear date filter">
                                                <i class="ti ti-x"></i>
                                            </button>
                                        }
                                    </div>
                                </div>

                                <!-- Status Filter -->
                                <div class="col-md-2">
                                    <label for="statusFilter" class="form-label">Status</label>
                                    <select id="statusFilter" name="statusFilter" class="form-select">
                                        <option value="">All Statuses</option>
                                        <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                                        <option value="Confirmed" selected="@(Model.StatusFilter == "Confirmed")">Confirmed</option>
                                        <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                                        <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                                    </select>
                                </div>

                                <!-- Page Size -->
                                <div class="col-md-2">
                                    <label for="pageSize" class="form-label">Per Page</label>
                                    <select id="pageSize" name="pageSize" class="form-select">
                                        <option value="5" selected="@(Model.PageSize == 5)">5</option>
                                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                                    </select>
                                </div>

                                <!-- Actions -->
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="ti ti-filter me-1"></i> Apply Filters
                                    </button>
                                </div>
                            </div>

                            <!-- Quick Date Navigation -->
                            <div class="row mt-3">
                                <div class="col-12">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-page="/Admin/Reservation" 
                                           asp-route-selectedDate="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")"
                                           asp-route-searchTerm="@Model.SearchTerm"
                                           asp-route-statusFilter="@Model.StatusFilter"
                                           asp-route-pageSize="@Model.PageSize"
                                           class="btn btn-outline-primary">
                                            <i class="ti ti-chevron-left"></i> Yesterday
                                        </a>
                                        <a asp-page="/Admin/Reservation"
                                           asp-route-searchTerm="@Model.SearchTerm"
                                           asp-route-statusFilter="@Model.StatusFilter"
                                           asp-route-pageSize="@Model.PageSize"
                                           class="btn btn-primary">
                                            All Dates
                                        </a>
                                        <a asp-page="/Admin/Reservation" 
                                           asp-route-selectedDate="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           asp-route-searchTerm="@Model.SearchTerm"
                                           asp-route-statusFilter="@Model.StatusFilter"
                                           asp-route-pageSize="@Model.PageSize"
                                           class="btn btn-outline-primary">
                                            Today
                                        </a>
                                        <a asp-page="/Admin/Reservation" 
                                           asp-route-selectedDate="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                           asp-route-searchTerm="@Model.SearchTerm"
                                           asp-route-statusFilter="@Model.StatusFilter"
                                           asp-route-pageSize="@Model.PageSize"
                                           class="btn btn-outline-primary">
                                            Tomorrow <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </div>
                                    <span class="badge bg-info ms-3">
                                        <i class="ti ti-calendar-event me-1"></i>
                                        @Model.PaginatedReservations.TotalCount total reservation(s)
                                        @if (Model.SelectedDate.HasValue)
                                        {
                                            <text> on @Model.SelectedDate.Value.ToString("MMM dd, yyyy")</text>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.StatusFilter))
                                        {
                                            <text> (filtered)</text>
                                        }
                                    </span>
                                    @if (Model.SelectedDate.HasValue || !string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.StatusFilter))
                                    {
                                        <a asp-page="/Admin/Reservation" class="btn btn-sm btn-outline-secondary ms-2">
                                            <i class="ti ti-x me-1"></i> Clear All Filters
                                        </a>
                                    }
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reservations Table -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        @if (Model.Reservations.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Time</th>
                                            <th>Customer</th>
                                            <th>Contact</th>
                                            <th>Guests</th>
                                            <th>Special Requests</th>
                                            <th>Status</th>
                                            <th class="text-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var reservation in Model.Reservations)
                                        {
                                            <tr id="reservation-@reservation.Id">
                                                <td>
                                                    <strong class="fs-5">@reservation.ReservationTime</strong>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar avatar-sm bg-primary text-white rounded-circle me-2">
                                                            @reservation.CustomerName.Substring(0, 1).ToUpper()
                                                        </div>
                                                        <div>
                                                            <strong>@reservation.CustomerName</strong>
                                                            <br />
                                                            <small class="text-muted">ID: #@reservation.Id</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div>
                                                        <i class="ti ti-phone me-1"></i>@reservation.PhoneNumber
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(reservation.Email))
                                                    {
                                                        <div class="text-muted small">
                                                            <i class="ti ti-mail me-1"></i>@reservation.Email
                                                        </div>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark">
                                                        <i class="ti ti-users me-1"></i>@reservation.NumberOfGuests
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(reservation.SpecialRequests))
                                                    {
                                                        <small>@reservation.SpecialRequests</small>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge @Model.GetStatusBadgeClass(reservation.Status)">
                                                        @reservation.Status
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="button" 
                                                                class="btn btn-outline-primary" 
                                                                data-bs-toggle="modal" 
                                                                data-bs-target="#editModal"
                                                                onclick="loadEditForm(@reservation.Id, @reservation.Version, '@reservation.CustomerName', '@reservation.Email', '@reservation.PhoneNumber', '@reservation.ReservationDate.ToString("MM/dd/yyyy")', '@reservation.ReservationTime', @reservation.NumberOfGuests, '@(reservation.SpecialRequests ?? "")')">
                                                            <i class="ti ti-edit"></i>
                                                        </button>

                                                        @if (reservation.Status == "Pending")
                                                        {
                                                            <form method="post" asp-page-handler="Confirm" style="display:inline;">
                                                                <input type="hidden" name="id" value="@reservation.Id" />
                                                                <input type="hidden" name="SelectedDate" value="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" />
                                                                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                                                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                                                <input type="hidden" name="PageSize" value="@Model.PageSize" />
                                                                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                                                <button type="submit" class="btn btn-outline-success" title="Confirm">
                                                                    <i class="ti ti-check"></i>
                                                                </button>
                                                            </form>
                                                        }

                                                        @if (reservation.Status == "Confirmed")
                                                        {
                                                            <form method="post" asp-page-handler="Complete" style="display:inline;">
                                                                <input type="hidden" name="id" value="@reservation.Id" />
                                                                <input type="hidden" name="SelectedDate" value="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" />
                                                                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                                                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                                                <input type="hidden" name="PageSize" value="@Model.PageSize" />
                                                                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                                                <button type="submit" class="btn btn-outline-secondary" title="Complete">
                                                                    <i class="ti ti-circle-check"></i>
                                                                </button>
                                                            </form>
                                                        }

                                                        @if (reservation.Status != "Cancelled" && reservation.Status != "Completed")
                                                        {
                                                            <form method="post" asp-page-handler="Cancel" style="display:inline;" onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
                                                                <input type="hidden" name="id" value="@reservation.Id" />
                                                                <input type="hidden" name="SelectedDate" value="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" />
                                                                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                                                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                                                <input type="hidden" name="PageSize" value="@Model.PageSize" />
                                                                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                                                <button type="submit" class="btn btn-outline-danger" title="Cancel">
                                                                    <i class="ti ti-x"></i>
                                                                </button>
                                                            </form>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination Controls -->
                            @if (Model.PaginatedReservations.TotalPages > 1)
                            {
                                <nav aria-label="Reservation pagination" class="mt-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="text-muted">
                                            Showing @((Model.PaginatedReservations.PageNumber - 1) * Model.PaginatedReservations.PageSize + 1) 
                                            to @Math.Min(Model.PaginatedReservations.PageNumber * Model.PaginatedReservations.PageSize, Model.PaginatedReservations.TotalCount)
                                            of @Model.PaginatedReservations.TotalCount reservations
                                        </div>
                                        <ul class="pagination mb-0">
                                            <!-- Previous Page -->
                                            <li class="page-item @(!Model.PaginatedReservations.HasPreviousPage ? "disabled" : "")">
                                                <a class="page-link" 
                                                   asp-page="/Admin/Reservation" 
                                                   asp-route-selectedDate="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" 
                                                   asp-route-searchTerm="@Model.SearchTerm"
                                                   asp-route-statusFilter="@Model.StatusFilter"
                                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                                   asp-route-pageSize="@Model.PageSize"
                                                   aria-label="Previous">
                                                    <span aria-hidden="true">&laquo;</span>
                                                </a>
                                            </li>

                                            @{
                                                var startPage = Math.Max(1, Model.PageNumber - 2);
                                                var endPage = Math.Min(Model.PaginatedReservations.TotalPages, Model.PageNumber + 2);
                                            }

                                            <!-- First Page -->
                                            @if (startPage > 1)
                                            {
                                                <li class="page-item">
                                                    <a class="page-link" 
                                                       asp-page="/Admin/Reservation" 
                                                       asp-route-selectedDate="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" 
                                                       asp-route-searchTerm="@Model.SearchTerm"
                                                       asp-route-statusFilter="@Model.StatusFilter"
                                                       asp-route-pageNumber="1"
                                                       asp-route-pageSize="@Model.PageSize">
                                                        1
                                                    </a>
                                                </li>
                                                @if (startPage > 2)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                }
                                            }

                                            <!-- Page Numbers -->
                                            @for (var i = startPage; i <= endPage; i++)
                                            {
                                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                    <a class="page-link" 
                                                       asp-page="/Admin/Reservation" 
                                                       asp-route-selectedDate="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" 
                                                       asp-route-searchTerm="@Model.SearchTerm"
                                                       asp-route-statusFilter="@Model.StatusFilter"
                                                       asp-route-pageNumber="@i"
                                                       asp-route-pageSize="@Model.PageSize">
                                                        @i
                                                    </a>
                                                </li>
                                            }

                                            <!-- Last Page -->
                                            @if (endPage < Model.PaginatedReservations.TotalPages)
                                            {
                                                @if (endPage < Model.PaginatedReservations.TotalPages - 1)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                }
                                                <li class="page-item">
                                                    <a class="page-link" 
                                                       asp-page="/Admin/Reservation" 
                                                       asp-route-selectedDate="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" 
                                                       asp-route-searchTerm="@Model.SearchTerm"
                                                       asp-route-statusFilter="@Model.StatusFilter"
                                                       asp-route-pageNumber="@Model.PaginatedReservations.TotalPages"
                                                       asp-route-pageSize="@Model.PageSize">
                                                        @Model.PaginatedReservations.TotalPages
                                                    </a>
                                                </li>
                                            }

                                            <!-- Next Page -->
                                            <li class="page-item @(!Model.PaginatedReservations.HasNextPage ? "disabled" : "")">
                                                <a class="page-link" 
                                                   asp-page="/Admin/Reservation" 
                                                   asp-route-selectedDate="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" 
                                                   asp-route-searchTerm="@Model.SearchTerm"
                                                   asp-route-statusFilter="@Model.StatusFilter"
                                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                                   asp-route-pageSize="@Model.PageSize"
                                                   aria-label="Next">
                                                    <span aria-hidden="true">&raquo;</span>
                                                </a>
                                            </li>
                                        </ul>

                                        <!-- Page Size Selector -->
                                        <div class="d-flex align-items-center">
                                            <label class="me-2 mb-0">Items per page:</label>
                                            <select class="form-select form-select-sm" style="width: auto;" onchange="changePageSize(this.value)">
                                                <option value="5" selected="@(Model.PageSize == 5)">5</option>
                                                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                                                <option value="20" selected="@(Model.PageSize == 20)">20</option>
                                                <option value="50" selected="@(Model.PageSize == 50)">50</option>
                                            </select>
                                        </div>
                                    </div>
                                </nav>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="ti ti-calendar-x display-1 text-muted"></i>
                                <h3 class="mt-3">No Reservations</h3>
                                <p class="text-muted">
                                    @if (Model.SelectedDate.HasValue)
                                    {
                                        <text>There are no reservations for @Model.SelectedDate.Value.ToString("MMMM dd, yyyy")</text>
                                    }
                                    else if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.StatusFilter))
                                    {
                                        <text>No reservations found matching your filters</text>
                                    }
                                    else
                                    {
                                        <text>There are no reservations yet</text>
                                    }
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Edit Reservation Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">
                        <i class="ti ti-edit me-2"></i>Edit Reservation
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="edit-id" />
                    <input type="hidden" name="version" id="edit-version" />
                    <input type="hidden" name="SelectedDate" value="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />
                    <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                    <input type="hidden" name="SortBy" value="@Model.SortBy" />
                    <input type="hidden" name="SortDescending" value="@Model.SortDescending" />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label for="edit-customerName" class="form-label">Customer Name *</label>
                            <input type="text" class="form-control" id="edit-customerName" name="customerName" required />
                        </div>

                        <div class="col-md-6">
                            <label for="edit-phone" class="form-label">Phone Number *</label>
                            <input type="tel" class="form-control" id="edit-phone" name="phone" required />
                        </div>

                        <div class="col-md-6">
                            <label for="edit-email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="edit-email" name="email" />
                        </div>

                        <div class="col-md-6">
                            <label for="edit-date" class="form-label">Reservation Date *</label>
                            <input type="date" class="form-control" id="edit-date" name="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-6">
                            <label for="edit-time" class="form-label">Reservation Time *</label>
                            <input type="time" class="form-control" id="edit-time" name="time" required />
                        </div>

                        <div class="col-md-12">
                            <label for="edit-guests" class="form-label">Number of Guests *</label>
                            <input type="number" class="form-control" id="edit-guests" name="guests" min="1" max="20" required />
                        </div>

                        <div class="col-md-12">
                            <label for="edit-message" class="form-label">Special Requests</label>
                            <textarea class="form-control" id="edit-message" name="message" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changePageSize(newSize) {
            var urlParams = new URLSearchParams(window.location.search);
            urlParams.set('pageSize', newSize);
            urlParams.set('pageNumber', '1'); // Reset to first page when changing page size
            window.location.search = urlParams.toString();
        }

        function clearDateFilter() {
            document.getElementById('selectedDate').value = '';
            document.getElementById('filterForm').submit();
        }

        function loadEditForm(id, version, name, email, phone, date, time, guests, message) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-version').value = version;
            document.getElementById('edit-customerName').value = name;
            document.getElementById('edit-email').value = email || '';
            document.getElementById('edit-phone').value = phone;
            document.getElementById('edit-date').value = formatDateForInput(date);
            document.getElementById('edit-time').value = convertTo24Hour(time);
            document.getElementById('edit-guests').value = guests;
            document.getElementById('edit-message').value = message || '';
        }

        function formatDateForInput(dateStr) {
            // Convert MM/dd/yyyy to yyyy-MM-dd
            var parts = dateStr.split('/');
            if (parts.length === 3) {
                var month = parts[0].padStart(2, '0');
                var day = parts[1].padStart(2, '0');
                var year = parts[2];
                return year + '-' + month + '-' + day;
            }
            return dateStr;
        }

        function convertTo24Hour(timeStr) {
            // Convert HH:mm format to HH:mm for time input
            // If already in 24-hour format, return as is
            if (timeStr.includes(':')) {
                var parts = timeStr.split(':');
                if (parts.length === 2) {
                    var hours = parts[0].padStart(2, '0');
                    var minutes = parts[1].padStart(2, '0');
                    return hours + ':' + minutes;
                }
            }
            return timeStr;
        }

        // Auto-dismiss alerts after 3 seconds
        $(document).ready(function() {
            setTimeout(function() {
                $('.alert').fadeOut('slow', function() {
                    $(this).remove();
                });
            }, 3000); // 3 seconds
        });
    </script>
}
