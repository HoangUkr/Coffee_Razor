@page
@model WebUI.Pages.Admin.CreateUserModel
@{
    ViewData["Title"] = "Add User";
}

<!-- MAIN CONTENT -->
<main id="content" class="content py-10">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
          <div class="">
            <h1 class="fs-3 mb-1">Add User</h1>
            <p class="mb-0">Create a new system user</p>
          </div>
          <div>
            <a asp-page="/Admin/Users" class="btn btn-outline-primary">
              <i class="ti ti-arrow-left me-2"></i>Back to Users
            </a>
          </div>
        </div>
      </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
      <div class="row">
        <div class="col-12">
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="ti ti-check me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        </div>
      </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
      <div class="row">
        <div class="col-12">
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="ti ti-alert-circle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        </div>
      </div>
    }

    <div class="row">
      <div class="col-12 col-lg-8 col-xl-6">
        <div class="card">
          <div class="card-header bg-white">
            <h5 class="mb-0">User Information</h5>
          </div>
          <div class="card-body p-4">
            <form method="post" autocomplete="off">
              <input type="text" name="fake-username" autocomplete="username" class="d-none" tabindex="-1" aria-hidden="true" />
              <input type="password" name="fake-password" autocomplete="new-password" class="d-none" tabindex="-1" aria-hidden="true" />
              <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

              <div class="mb-3">
                <label asp-for="Input.Username" class="form-label fw-semibold">Username <span class="text-danger">*</span></label>
                <input asp-for="Input.Username" class="form-control" placeholder="Enter username" autofocus autocomplete="off" autocapitalize="none" spellcheck="false" />
                <span asp-validation-for="Input.Username" class="text-danger small"></span>
                <small class="text-muted">3-50 characters, alphanumeric and underscores allowed</small>
              </div>

              <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Enter password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                <small class="text-muted">Minimum 6 characters</small>
              </div>

              <div class="mb-3">
                <label asp-for="Input.Role" class="form-label fw-semibold">Role <span class="text-danger">*</span></label>
                <select asp-for="Input.Role" class="form-select">
                  <option value="Staff">Staff</option>
                  <option value="Admin">Admin</option>
                </select>
                <span asp-validation-for="Input.Role" class="text-danger small"></span>
                <small class="text-muted d-block mt-1">
                  <strong>Staff:</strong> Basic access to manage inventory and orders<br>
                  <strong>Admin:</strong> Full access to all system features
                </small>
              </div>

              <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                  <i class="ti ti-plus me-2"></i>Add User
                </button>
                <button type="reset" class="btn btn-secondary">
                  <i class="ti ti-refresh me-2"></i>Clear Form
                </button>
                <a asp-page="/Admin/Users" class="btn btn-outline-secondary">
                  <i class="ti ti-x me-2"></i>Cancel
                </a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-12">
        <footer class="text-center py-2 mt-6 text-secondary">
          <p class="mb-0">Copyright © @DateTime.Now.Year Coffee Shop Admin Panel</p>
        </footer>
      </div>
    </div>
  </div>
</main>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
