@page
@model WebUI.Pages.Admin.ItemDetailModel
@{
    ViewData["Title"] = "Item Details";
    Layout = "~/Pages/Shared/_LayoutAdmin.cshtml";
}

<!-- MAIN CONTENT -->
<main id="content" class="content py-10">
    <div class="container-fluid">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="fs-3 mb-1">@Model.Item?.Name</h1>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Dashboard</a></li>
                                <li class="breadcrumb-item"><a asp-page="/Admin/Inventory">Inventory</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Item Details</li>
                            </ol>
                        </nav>
                    </div>
                    <div>
                        <a asp-page="/Admin/Inventory" class="btn btn-outline-secondary">
                            <i class="ti ti-arrow-left me-1"></i> Back to Inventory
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Success/Error Messages -->
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="ti ti-check me-2"></i>@Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="ti ti-alert-circle me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Main Form Wrapping Item Details and Image Selection -->
        <form method="post" asp-page-handler="UpdateDetails">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Input.Version" />

            <div class="row">
                <!-- Item Details Card -->
                <div class="col-lg-8">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                <i class="ti ti-info-circle me-2"></i>Item Information
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label for="input-name" class="form-label">Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="input-name" asp-for="Input.Name" required>
                                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label for="input-price" class="form-label">Price <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="number" class="form-control" id="input-price" asp-for="Input.Price" step="0.01" min="0" required>
                                    </div>
                                    <span asp-validation-for="Input.Price" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label for="input-category" class="form-label">Category <span class="text-danger">*</span></label>
                                    <select class="form-select" id="input-category" asp-for="Input.CategoryId" asp-items="Model.Categories" required>
                                        <option value="">Select Category</option>
                                    </select>
                                    <span asp-validation-for="Input.CategoryId" class="text-danger"></span>
                                </div>

                                <div class="col-md-12">
                                    <label for="input-description" class="form-label">Description</label>
                                    <textarea class="form-control" id="input-description" asp-for="Input.Description" rows="4"></textarea>
                                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                                </div>

                                <div class="col-md-12">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="input-active" asp-for="Input.IsActive">
                                        <label class="form-check-label" for="input-active">
                                            Item is Active
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            <!-- Item Summary Card -->
            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="ti ti-file-info me-2"></i>Item Summary
                        </h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Status:</dt>
                            <dd class="col-sm-7">
                                @if (Model.Item?.IsActive == true)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </dd>

                            <dt class="col-sm-5">Category:</dt>
                            <dd class="col-sm-7">@Model.Item?.CategoryName</dd>

                            <dt class="col-sm-5">Price:</dt>
                            <dd class="col-sm-7">$@Model.Item?.Price.ToString("N2")</dd>

                            <dt class="col-sm-5">Created:</dt>
                            <dd class="col-sm-7">@(Model.Item != null ? "N/A" : "")</dd>

                            <dt class="col-sm-5">Images:</dt>
                            <dd class="col-sm-7">
                                <span class="badge bg-info">@Model.ItemImages.Count() total</span>
                                <span class="badge bg-success">@Model.ItemImages.Count(i => i.IsActive) active</span>
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <!-- Image Gallery Section -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">
                                <i class="ti ti-photo me-2"></i>Image Gallery
                            </h5>
                            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#uploadImageModal">
                                <i class="ti ti-upload me-1"></i>Upload New Image
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model.ItemImages.Any())
                        {
                            <div class="row g-3">
                                @foreach (var image in Model.ItemImages.OrderByDescending(i => i.IsDefault).ThenByDescending(i => i.IsActive))
                                {
                                    <div class="col-md-6 col-lg-4 col-xl-3">
                                        <div class="card @(!image.IsActive ? "border-secondary" : "") @(Model.SelectedDefaultImageId == image.Id ? "border-primary border-2" : "")">
                                            <div class="position-relative">
                                                <img src="@image.Url" class="card-img-top" alt="@Model.Item?.Name" style="height: 200px; object-fit: cover;">
                                                @if (image.IsDefault)
                                                {
                                                    <span class="position-absolute top-0 start-0 m-2 badge bg-primary">
                                                        <i class="ti ti-star-filled"></i> Current Default
                                                    </span>
                                                }
                                                @if (Model.SelectedDefaultImageId == image.Id && !image.IsDefault)
                                                {
                                                    <span class="position-absolute top-0 start-0 m-2 badge bg-warning">
                                                        <i class="ti ti-star"></i> Will be Default
                                                    </span>
                                                }
                                                @if (!image.IsActive)
                                                {
                                                    <span class="position-absolute top-0 end-0 m-2 badge bg-secondary">
                                                        Inactive
                                                    </span>
                                                }
                                            </div>
                                            <div class="card-body p-2">
                                                <div class="d-flex gap-2 align-items-center">
                                                    <!-- Radio button for selecting default -->
                                                    <div class="form-check flex-grow-1">
                                                        <input class="form-check-input" type="radio" name="SelectedDefaultImageId" value="@image.Id" id="radio-@image.Id" 
                                                               @(Model.SelectedDefaultImageId == image.Id ? "checked" : "")>
                                                        <label class="form-check-label" for="radio-@image.Id">
                                                            <small>Set as Default</small>
                                                        </label>
                                                    </div>

                                                    <!-- Toggle Active/Inactive - immediate action -->
                                                    <button type="button" class="btn btn-sm @(image.IsActive ? "btn-outline-warning" : "btn-outline-success")" 
                                                            onclick="submitToggleImage(@image.Id, @image.IsActive.ToString().ToLower())"
                                                            title="@(image.IsActive ? "Deactivate" : "Activate")">
                                                        <i class="ti ti-@(image.IsActive ? "eye-off" : "eye")"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="ti ti-photo-off display-1 text-muted"></i>
                                <h4 class="mt-3">No Images</h4>
                                <p class="text-muted">Upload an image to get started</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Save Button at Bottom -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="ti ti-device-floppy me-2"></i>Save All Changes
                        </button>
                        <a asp-page="/Admin/Inventory" class="btn btn-outline-secondary btn-lg ms-2">
                            <i class="ti ti-x me-2"></i>Cancel
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</main>

<!-- Upload Image Modal -->
<div class="modal fade" id="uploadImageModal" tabindex="-1" aria-labelledby="uploadImageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="UploadImage" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="uploadImageModalLabel">
                        <i class="ti ti-upload me-2"></i>Upload New Image
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="new-image-file" class="form-label">Select Image <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" id="new-image-file" asp-for="NewImageFile" accept="image/*" required>
                        <div class="form-text">
                            Allowed formats: JPG, PNG, GIF. Max size: 5MB
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-upload me-2"></i>Upload Image
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- Hidden forms for immediate actions -->
    <form id="toggleImageForm" method="post" asp-page-handler="ToggleImage" style="display:none;">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" id="toggleImageId" name="imageId" />
        <input type="hidden" id="toggleIsActive" name="isActive" />
    </form>

    <form id="deleteImageForm" method="post" asp-page-handler="DeleteImage" style="display:none;">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" id="deleteImageId" name="imageId" />
    </form>

    <script>
        function submitToggleImage(imageId, isActive) {
            document.getElementById('toggleImageId').value = imageId;
            document.getElementById('toggleIsActive').value = isActive;
            document.getElementById('toggleImageForm').submit();
        }

        function submitDeleteImage(imageId) {
            if (confirm('Are you sure you want to delete this image? This cannot be undone.')) {
                document.getElementById('deleteImageId').value = imageId;
                document.getElementById('deleteImageForm').submit();
            }
        }

        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            $('.alert').fadeOut('slow', function() {
                $(this).remove();
            });
        }, 5000);
    </script>
}
