@page
@model WebUI.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Users";
}

<!-- MAIN CONTENT -->
<main id="content" class="content py-10">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="">
                        <h1 class="fs-3 mb-1">Users</h1>
                        <p class="mb-0">Manage system users</p>
                    </div>
                    <div>
                        <a asp-page="/Admin/CreateUser" class="btn btn-primary">
                            <i class="ti ti-plus me-2"></i>Add User
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="ti ti-check me-2"></i>@Model.SuccessMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="ti ti-alert-circle me-2"></i>@Model.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        }

        <!-- Search and Filter -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <form method="get" class="row g-3">
                            <div class="col-md-10">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="ti ti-search"></i></span>
                                    <input type="text" 
                                           name="SearchTerm" 
                                           value="@Model.SearchTerm" 
                                           class="form-control" 
                                           placeholder="Search by username or role..." />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="ti ti-search me-1"></i>Search
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.SearchTerm))
                            {
                                <div class="col-12">
                                    <a asp-page="/Admin/Users" class="btn btn-sm btn-outline-secondary">
                                        <i class="ti ti-x me-1"></i>Clear Search
                                    </a>
                                    <span class="text-muted ms-2">Found @Model.Users.TotalCount result(s)</span>
                                </div>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card table-responsive">
                    <table class="table mb-0 text-nowrap table-hover">
                        <thead class="table-light border-light">
                            <tr>
                                <th>Username</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Created Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Users.Items.Any())
                            {
                                @foreach (var user in Model.Users.Items)
                                {
                                    <tr class="align-middle" id="user-row-@user.Id">
                                        <td>
                                            <span class="fw-semibold">@user.Username</span>
                                        </td>
                                        <td>
                                            @if (user.Role == "Admin")
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="ti ti-shield-check me-1"></i>Admin
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">
                                                    <i class="ti ti-user me-1"></i>Staff
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")" id="status-badge-@user.Id">
                                                @(user.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>@user.CreatedDate.ToString("MMM dd, yyyy")</td>
                                        <td class="">
                                            <button type="button" class="btn btn-sm btn-link p-0" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#editModal"
                                                    data-user-id="@user.Id"
                                                    data-user-username="@user.Username"
                                                    data-user-role="@user.Role"
                                                    title="Edit">
                                                <i class="ti ti-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-link p-0 ms-2" 
                                                    onclick="toggleUserStatus('@user.Id', @user.IsActive.ToString().ToLower())"
                                                    title="@(user.IsActive ? "Deactivate" : "Activate")">
                                                <i class="ti ti-power @(user.IsActive ? "text-warning" : "text-success")"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-link p-0 link-danger ms-2" 
                                                    onclick="confirmDelete('@user.Id', '@user.Username')"
                                                    title="Delete">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        <i class="ti ti-users-off fs-1 d-block mb-2"></i>
                                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                                        {
                                            <text>No users found matching "@Model.SearchTerm".</text>
                                        }
                                        else
                                        {
                                            <text>No users found. Click "Add User" to create one.</text>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.Users.TotalPages > 1)
                {
                    <div class="card-footer">
                        <nav aria-label="User pagination">
                            <ul class="pagination justify-content-center mb-0">
                                <li class="page-item @(!Model.Users.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" 
                                       asp-page="/Admin/Users" 
                                       asp-route-pageNumber="@(Model.Users.PageNumber - 1)"
                                       asp-route-searchTerm="@Model.SearchTerm">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.Users.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.Users.PageNumber ? "active" : "")">
                                        <a class="page-link" 
                                           asp-page="/Admin/Users" 
                                           asp-route-pageNumber="@i"
                                           asp-route-searchTerm="@Model.SearchTerm">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(!Model.Users.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" 
                                       asp-page="/Admin/Users" 
                                       asp-route-pageNumber="@(Model.Users.PageNumber + 1)"
                                       asp-route-searchTerm="@Model.SearchTerm">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                        <p class="text-center text-muted small mt-2 mb-0">
                            Showing @Model.Users.Items.Count() of @Model.Users.TotalCount users (Page @Model.Users.PageNumber of @Model.Users.TotalPages)
                        </p>
                    </div>
                }
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <footer class="text-center py-2 mt-6 text-secondary">
                    <p class="mb-0">Copyright © @DateTime.Now.Year Coffee Shop Admin Panel</p>
                </footer>
            </div>
        </div>
    </div>
</main>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">
                        <i class="ti ti-edit me-2"></i>Edit User
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="EditUserId" id="editUserId" />
                    <div class="mb-3">
                        <label asp-for="EditInput.Username" class="form-label fw-semibold">Username <span class="text-danger">*</span></label>
                        <input asp-for="EditInput.Username" id="editUsername" class="form-control" placeholder="Enter username" />
                        <span asp-validation-for="EditInput.Username" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditInput.Role" class="form-label fw-semibold">Role <span class="text-danger">*</span></label>
                        <select asp-for="EditInput.Role" id="editRole" class="form-select">
                            <option value="Staff">Staff</option>
                            <option value="Admin">Admin</option>
                        </select>
                        <span asp-validation-for="EditInput.Role" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="ti ti-x me-2"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete" id="deleteForm">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteModalLabel">
                        <i class="ti ti-alert-triangle me-2"></i>Delete User
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="deleteUserId" />
                    <p class="mb-0">Are you sure you want to delete the user <strong id="deleteUsername"></strong>?</p>
                    <p class="text-muted small mb-0 mt-2">
                        <i class="ti ti-info-circle me-1"></i>This action cannot be undone.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="ti ti-x me-2"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-danger">
                        <i class="ti ti-trash me-2"></i>Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Edit modal functionality
        const editModal = document.getElementById('editModal');
        if (editModal) {
            editModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const userId = button.getAttribute('data-user-id');
                const username = button.getAttribute('data-user-username');
                const role = button.getAttribute('data-user-role');
                
                document.getElementById('editUserId').value = userId;
                document.getElementById('editUsername').value = username;
                document.getElementById('editRole').value = role;
            });
        }

        // Delete confirmation functionality
        function confirmDelete(id, username) {
            document.getElementById('deleteUserId').value = id;
            document.getElementById('deleteUsername').textContent = username;
            
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }

        // Toggle user status (activate/deactivate)
        async function toggleUserStatus(userId, isActive) {
            const action = isActive ? 'deactivate' : 'activate';
            if (!confirm(`Are you sure you want to ${action} this user?`)) {
                return;
            }

            try {
                const response = await fetch('?handler=ToggleStatus&id=' + userId, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                const result = await response.json();

                if (result.success) {
                    // Update the status badge
                    const badge = document.getElementById(`status-badge-${userId}`);
                    if (result.isActive) {
                        badge.classList.remove('bg-secondary');
                        badge.classList.add('bg-success');
                        badge.textContent = 'Active';
                    } else {
                        badge.classList.remove('bg-success');
                        badge.classList.add('bg-secondary');
                        badge.textContent = 'Inactive';
                    }

                    showToast('success', result.message);
                    
                    // Reload page after a short delay to refresh the data
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showToast('error', result.message || 'Failed to update user status');
                }
            } catch (error) {
                console.error('Error toggling user status:', error);
                showToast('error', 'An error occurred while updating user status');
            }
        }

        // Toast notification
        function showToast(type, message) {
            const toastContainer = document.createElement('div');
            toastContainer.style.cssText = 'position: fixed; top: 20px; right: 20px; z-index: 9999;';
            
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const icon = type === 'success' ? 'ti-check' : 'ti-alert-circle';
            
            toastContainer.innerHTML = `
                <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                    <i class="ti ${icon} me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            
            document.body.appendChild(toastContainer);
            
            setTimeout(() => {
                toastContainer.remove();
            }, 3000);
        }
    </script>
}
