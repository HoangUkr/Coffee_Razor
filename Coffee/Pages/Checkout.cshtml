@page
@model WebUI.Pages.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<!-- HERO SECTION -->
<section class="home-slider owl-carousel">
    <div class="slider-item" style="background-image: url(@Url.Content("~/images/bg_3.jpg"));">
        <div class="overlay"></div>
        <div class="container">
            <div class="row slider-text justify-content-center align-items-center">
                <div class="col-md-7 col-sm-12 text-center ftco-animate">
                    <h1 class="mb-3 mt-5 bread">Checkout</h1>
                    <p class="breadcrumbs">
                        <span class="mr-2"><a asp-page="/Index">Home</a></span>
                        <span>Checkout</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CHECKOUT SECTION -->
<section class="ftco-section">
    <div class="container">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="icon-alert-circle"></i> @Model.ErrorMessage
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="row">
            <div class="col-xl-8 ftco-animate">
                <form method="post" class="billing-form ftco-bg-dark p-3 p-md-5">
                    <h3 class="mb-4 billing-heading">Customer Information</h3>

                    <div class="row align-items-end">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Input.FirstName">First Name *</label>
                                <input type="text" asp-for="Input.FirstName" class="form-control">
                                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Input.LastName">Last Name *</label>
                                <input type="text" asp-for="Input.LastName" class="form-control">
                                <span asp-validation-for="Input.LastName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="w-100"></div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Input.Phone">Phone Number *</label>
                                <input type="tel" asp-for="Input.Phone" class="form-control">
                                <span asp-validation-for="Input.Phone" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Input.Email">Email (Optional)</label>
                                <input type="email" asp-for="Input.Email" class="form-control">
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="w-100"></div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Fulfillment Type *</label>
                                <div class="d-flex">
                                    <label class="mr-4">
                                        <input type="radio" asp-for="Input.OutHouseFulfillmentType" value="0" class="mr-2" onchange="toggleAddressField()">
                                        Pickup
                                    </label>
                                    <label>
                                        <input type="radio" asp-for="Input.OutHouseFulfillmentType" value="1" class="mr-2" onchange="toggleAddressField()">
                                        Delivery
                                    </label>
                                </div>
                                <span asp-validation-for="Input.OutHouseFulfillmentType" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="w-100"></div>
                        <div class="col-md-12" id="addressField" style="display:none;">
                            <div class="form-group">
                                <label asp-for="Input.Address">Delivery Address *</label>
                                <input type="text" asp-for="Input.Address" class="form-control" placeholder="Street address, city, postal code">
                                <span asp-validation-for="Input.Address" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="w-100"></div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label asp-for="Input.Notes">Special Instructions (Optional)</label>
                                <textarea asp-for="Input.Notes" class="form-control" rows="3" placeholder="Notes about your order"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info mt-4">
                        <h5 style="color: #000;"><i class="icon-info-circle"></i> Privacy Notice</h5>
                        <p class="mb-0" style="color: #000; font-weight: 600;">
                            Your personal information (name, email, phone number, address) will be used only to process and deliver your order. 
                            For your privacy and security, all personal data will be automatically cleared from our system after your order is completed.
                        </p>
                    </div>

                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary py-3 px-5">Place Order</button>
                        <a asp-page="/Cart" class="btn btn-secondary py-3 px-5 ml-2">Back to Cart</a>
                    </div>
                </form>
            </div>

            <div class="col-xl-4 sidebar ftco-animate">
                <div class="sidebar-box ftco-animate">
                    <h3 class="heading-2">Order Summary</h3>

                    @if (Model.CartItems.Any())
                    {
                        <ul class="list-unstyled">
                            @foreach (var item in Model.CartItems)
                            {
                                <li class="d-flex justify-content-between mb-2">
                                    <span>@item.Name x @item.Quantity</span>
                                    <span>@item.LineTotal.ToString("C")</span>
                                </li>
                            }
                        </ul>
                        <hr>
                        <ul class="list-unstyled">
                            <li class="d-flex justify-content-between">
                                <span>Subtotal</span>
                                <span>@Model.Subtotal.ToString("C")</span>
                            </li>
                            <li class="d-flex justify-content-between font-weight-bold">
                                <span>Total</span>
                                <span>@Model.Total.ToString("C")</span>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">Your cart is empty.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function toggleAddressField() {
            const deliveryRadio = document.querySelector('input[name="Input.OutHouseFulfillmentType"][value="1"]');
            const addressField = document.getElementById('addressField');
            addressField.style.display = deliveryRadio && deliveryRadio.checked ? 'block' : 'none';
        }

        document.addEventListener('DOMContentLoaded', toggleAddressField);
    </script>
}
